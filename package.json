{
  "name": "squirrel-notes-desktop",
  "version": "0.2.0",
  "description": "松鼠症笔记 — 以笔记为中心的 Markdown 笔记软件，内嵌离线语音转写（sherpa-onnx）、说话人分离、DeepSeek 一键生成笔记。",
  "main": "./out/main/index.js",
  "author": "ZhengJL18",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@uiw/react-codemirror": "^4.25.11",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "katex": "^0.18.1",
    "markdown-it": "^15.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sherpa-onnx-node": "^1.13.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.zhengjl.squirrelnotes",
    "productName": "松鼠症笔记",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/ffmpeg-static/**",
      "node_modules/sherpa-onnx-node/**"
    ],
    "npmRebuild": true,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "squirrel-notes-setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "松鼠症笔记",
      "artifactName": "squirrel-notes-setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "ZhengJL18",
      "repo": "squirrel-notes-desktop"
    }
  }
}
